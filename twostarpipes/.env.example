# Server quotation submission (publishable or legacy anon key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional browser client; same project and public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Browser public widget key (rebuild after changing)
VITE_TURNSTILE_SITE_KEY=
# Server only: never prefix these with VITE_
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.twostarpipes.com,twostarpipes.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret of at least 32 characters for phone HMACs
QUOTE_RATE_LIMIT_SECRET=
# Expiring signed JWT with role=quote_writer; NOT a service-role key
SUPABASE_QUOTE_WRITER_KEY=

# Optional managed catalogue; enable only after importing and checking all products
MANAGED_CATALOGUE=false
# Notification worker (disabled until provider + scheduler + recipients are configured)
SITE_URL=https://www.twostarpipes.com
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_CRON_SECRET=
SUPABASE_NOTIFICATION_WORKER_KEY=

# Optional anonymous counters; browser opt-in is also required
ANALYTICS_ENABLED=false
